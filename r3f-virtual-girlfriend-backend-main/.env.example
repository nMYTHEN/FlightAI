# --- Chat (LLM) ---
# Provider: "openai" (default) oder "anthropic"
LLM_PROVIDER=openai
# Obergrenze Tokens pro Antwort (war frueher 100000 -> jetzt gedeckelt)
LLM_MAX_TOKENS=4096

# OpenAI (Chat + TTS)
OPENAI_API_KEY=sk-XXX
OPENAI_MODEL=o4-mini

# Anthropic / Claude (nur wenn LLM_PROVIDER=anthropic; braucht: npm i @anthropic-ai/sdk)
ANTHROPIC_API_KEY=sk-ant-XXX
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Daten ---
# Datenquelle: "mock" (default, public/mock.json) oder "api" (echte Reise-API).
DATA_PROVIDER=mock
# Fuer DATA_PROVIDER=api (siehe data/apiProvider.js):
# API_URL=https://...            # Endpoint der Reise-API
# API_KEY=...                    # Zugangsschluessel (als Bearer gesendet)
# API_AUTH_HEADER=Authorization  # Header-Name fuer den Key (optional)

# --- TTS (OpenAI) ---
TTS_MODEL=tts-1                 # oder tts-1-hd (bessere Qualitaet, teurer/langsamer)
TTS_VOICE=nova                  # weiblich; Alternativen: shimmer, alloy, fable, echo, onyx
TTS_SPEED=1.0

# --- Leads ---
LEADS_PASSWORD=changeme         # Passwort fuer das Leads-Dashboard (/admin/leads, HTTP Basic Auth)
# LEAD_WEBHOOK_URL=https://...  # optional: Kontaktanfragen an Martireisen posten

# --- TTS-Alternative (optional, aktuell ungenutzt) ---
ELEVEN_LABS_API_KEY=XXX
